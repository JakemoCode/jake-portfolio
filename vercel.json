{
  "redirects": [
    {
      "source": "/portfolio",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/portfolio/",
      "destination": "/",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
